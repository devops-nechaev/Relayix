# Required: choose your own database password.
# For an external database, use its existing password.
POSTGRES_PASSWORD=''

# Required: choose your administrator password (12-128 characters,
# uppercase and lowercase letters, a number and a symbol).
ADMIN_PASSWORD=''

# Optional: the web UI is available at http://SERVER_IP:8080.
ADMIN_USERNAME=admin
BIND_ADDRESS=0.0.0.0
PORT=8080

# External PostgreSQL only: set the existing database host and credentials.
# These settings are ignored by the bundled PostgreSQL Compose file.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=relayix
POSTGRES_DB=relayix
POSTGRES_SSLMODE=verify-full

# Optional: set true when serving the UI behind HTTPS.
COOKIE_SECURE=false

# Optional: credentials for Telegram MTProto / WEB proxies only.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
